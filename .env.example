# Supabase — public credentials, inlined into the client bundle at build time.
# These are the ONLY app env vars v1 needs (anon key + RLS only; no service_role).
#
# Get both from: Supabase dashboard -> Settings -> API
#   NEXT_PUBLIC_SUPABASE_URL       <- "Project URL"
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  <- "anon"/"public" key (newer projects: "publishable" key)
#
# Env-file layout (all gitignored except this example):
#   .env         -> HOSTED project. Single source of truth. Used by `pnpm dev`
#                   (default), the build, and the Workers preview/prod runtime
#                   (the @opennextjs/cloudflare adapter injects .env* at runtime,
#                   so there is NO .dev.vars to keep in sync).
#   .env.localdb -> LOCAL Supabase stack (http://127.0.0.1:54321 + local anon key
#                   from `supabase status`). Loaded ONLY by `pnpm dev:local`.
#                   Never put localhost in .env — workerd can't reach it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
