# Supabase — public credentials, inlined into the client bundle at build time.
# These are the ONLY app env vars v1 needs (anon key + RLS only; no service_role).
#
# Get both from: Supabase dashboard -> Settings -> API
#   NEXT_PUBLIC_SUPABASE_URL       <- "Project URL"
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  <- "anon"/"public" key (newer projects: "publishable" key)
#
# Copy the values into .env.local (for `pnpm dev`) and .dev.vars (for `pnpm preview`),
# both pointing at the HOSTED project during deployment. Never commit those files.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
