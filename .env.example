# Supabase — public credentials, inlined into the client bundle at build time.
# These are the ONLY app env vars v1 needs (anon key + RLS only; no service_role).
#
# Get both from: Supabase dashboard -> Settings -> API
#   NEXT_PUBLIC_SUPABASE_URL       <- "Project URL"
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  <- "anon"/"public" key (newer projects: "publishable" key)
#
# Env-file layout (all gitignored except this example):
#   .env         -> HOSTED project. Single source of truth. Used by `pnpm dev`
#                   (default), the build, and the Workers preview/prod runtime
#                   (the @opennextjs/cloudflare adapter injects .env* at runtime,
#                   so there is NO .dev.vars to keep in sync).
#   .env.localdb -> LOCAL Supabase stack (http://127.0.0.1:54321 + local anon key
#                   from `supabase status`). Loaded ONLY by `pnpm dev:local`.
#                   Never put localhost in .env — workerd can't reach it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origin used to build the email-confirmation link (src/app/actions/auth.ts ->
# emailRedirectTo) AND, since S-01 (create-and-share-event-list), the guest
# share link and the organizer's own manage link (src/app/events/[id]/page.tsx).
# Read from CONFIG, never from the request Host header, so a caller cannot
# influence the origin of a link that gets emailed or shown as canonical.
#
# NO LONGER DORMANT: the events page needs a real, absolute value to build a
# copyable link — leaving this unset degrades that link to a relative path,
# which is not shareable. The email-confirmation use is still dormant while
# `enable_confirmations = false` (unset was safe there; it no longer is here).
#
#   pnpm dev / dev:local -> http://localhost:3000
#   preview              -> the deployment URL
#   production           -> the production Workers origin
#
# GAP: Cloudflare preview URLs are per-deployment, so one static value cannot be
# correct for every preview. This was acceptable while the only consumer was
# confirmation emails (off by default); now that the events page depends on it
# for a user-visible link, whoever sets up preview/production deploys must set
# this per deployment rather than leaving it at the dev value.
#
# ALSO MANUAL: the hosted project's Auth -> URL Configuration must list the
# production Workers origin and the preview origins. Supabase matches redirect
# URLs exactly, and no file in this repo can perform that dashboard step.
NEXT_PUBLIC_SITE_URL=
